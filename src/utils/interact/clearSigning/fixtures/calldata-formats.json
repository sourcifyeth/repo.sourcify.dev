{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Formats test",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x00000000000000000000000000000000000f0f0f" }] }
  },
  "metadata": {
    "owner": "Sourcify tests",
    "contractName": "Formats",
    "enums": { "mode": { "0": "Stable", "1": "Variable" } }
  },
  "display": {
    "formats": {
      "schedule(uint256 start, uint32 lock, uint24 rate, uint8 mode, uint256 height, (address token, uint256 amount)[] orders)": {
        "intent": "Schedule",
        "fields": [
          { "path": "start", "label": "Start date", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "lock", "label": "Lock time", "format": "duration" },
          {
            "path": "rate",
            "label": "Rate",
            "format": "unit",
            "params": { "decimals": 2, "base": "%", "prefix": false }
          },
          { "path": "mode", "label": "Interest mode", "format": "enum", "params": { "$ref": "$.metadata.enums.mode" } },
          { "path": "height", "label": "At block", "format": "date", "params": { "encoding": "blockheight" } },
          {
            "path": "orders.[].amount",
            "label": "Order amount",
            "format": "tokenAmount",
            "params": { "tokenPath": "orders.[].token" }
          },
          { "path": "orders.[].token", "label": "Order token", "format": "addressName" }
        ]
      }
    }
  }
}
