SOURCIFY_SERVER_URL=https://sourcify.dev/server
SOURCIFY_SERVER_INTERNAL_URL=https://sourcify.dev/server # URL for server-to-server calls. In production the Sourcify server's direct Cloud Run *.run.app URL, so the traffic doesn't go through the public load balancer
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id # Optional
NODE_ENV=development                               # Set "production" for production environment
